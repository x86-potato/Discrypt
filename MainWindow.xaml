<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Discrypt.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Discrypt"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Discrypt">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"
            Spacing="16"
            MaxWidth="380"
            Margin="24">

            <TextBlock 
                Text="🔐 Discrypt" 
                FontSize="32" 
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,4"/>

            <TextBlock 
                Text="Background Encryption Service" 
                FontSize="12"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="0,0,0,12"/>

            <Border 
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="24"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon 
                            Glyph="&#xE73E;" 
                            FontSize="24"/>
                        <TextBlock 
                            Text="Discord Injection Status" 
                            FontSize="16" 
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock 
                        x:Name="InjectionStatus"
                        Text="⏳ Checking..."
                        FontSize="14"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border 
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="18"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="10">
                    <Button 
                        x:Name="InjectDiscordButton"
                        Content="🔌 Inject into Discord"
                        Click="InjectDiscordButton_Click"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"/>

                    <Button 
                        x:Name="ClearDataButton"
                        Content="🗑️ Clear All Data"
                        Click="ClearDataButton_Click"
                        HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <TextBlock 
                Text="Use Alt+Enter in Discord to encrypt/decrypt messages"
                FontSize="11"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</Window>